# NEVER COMMIT:
# ~/.icx/config.json - contains workflow-specific API tokens, OAuth access+refresh tokens, LLM API keys
# .env files - any local environment overrides
# __pycache__ - Python bytecode, auto-generated

# ── Python artifacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Build and distribution ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Testing and coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── IDE and editor files ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Local env files ───────────────────────────────────────────────────────────
.env
.env.local
*.env

# ── MCP host config files ─────────────────────────────────────────────────────
# .claude/ is written by `icx mcp start` for Claude Code integration
# .cursor/ is written by `icx mcp start` relative to project root - must be excluded
.claude/
.cursor/
claude.md

# ── Internal dev docs - session notes, phase logs, planning ──────────────────
docs/
